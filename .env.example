# Copy this file to .env for local development.
# NEVER commit .env or paste real API keys into GitHub.

AETHER_SECRET_KEY=replace-with-a-long-random-secret
AETHER_DB_PATH=./aether.db
AETHER_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Groq (recommended starting provider)
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=PASTE_YOUR_GROQ_MODEL_ID_HERE

# Optional: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI-compatible provider
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
