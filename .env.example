# Copy to .env for local development. Never commit real secrets.
AETHER_SECRET_KEY=replace-with-a-long-random-secret
AETHER_DB_PATH=./aether.db
AETHER_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Choose Gemini OR an OpenAI-compatible provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
